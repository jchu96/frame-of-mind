# Required for the current Gemini Developer API Files pipeline.
# Create an auth key in Google AI Studio. Never commit a populated .env.
GEMINI_API_KEY=

# Optional model override.
GEMINI_MODEL=gemini-3.6-flash

# Optional provider endpoint overrides for development only.
BLUEDOT_MCP_URL=https://app.bluedothq.com/api/v1/mcp
GRANOLA_MCP_URL=https://mcp.granola.ai/mcp

# Optional official Granola REST API key.
GRANOLA_API_KEY=

# Optional opt-in error telemetry. When unset, no Sentry events are sent.
# SENTRY_DSN=

# Optional generated-run root override. Use an absolute private path for Studio.
FRAME_OF_MIND_OUTPUT=

# Optional Studio staging-root overrides. Use absolute private paths outside
# the checkout. Leave unset for per-user application-data defaults.
FRAME_OF_MIND_MEDIA_ROOT=
FRAME_OF_MIND_CONTEXT_ROOT=

# Optional local Nuxt review workspace. The Studio launcher defaults to
# per-user application data when this is left unset.
NUXT_AUTH_MODE=off
NUXT_SQLITE_PATH=.data/frame-of-mind.sqlite

# Hosted mode only. Set in the Worker environment, not a public clone.
NUXT_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
NUXT_CLOUDFLARE_ACCESS_AUD=

# Better Auth hosted modes only. Set secrets on the public Nuxt Worker; never
# expose them through public runtime config or the browser.
NUXT_BETTER_AUTH_URL=
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_GITHUB_CLIENT_ID=
NUXT_BETTER_AUTH_GITHUB_CLIENT_SECRET=
NUXT_BETTER_AUTH_MAILER_ORIGIN=
NUXT_BETTER_AUTH_MAILER_KEY=
NUXT_MAINTAINER_EMAILS=
