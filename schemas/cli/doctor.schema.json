{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {"schemaVersion": {"const": 1}},
  "if": {"required": ["error"]},
  "then": {
    "properties": {
      "error": {
        "type": "object",
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}},
        "required": ["code", "message"]
      }
    }
  },
  "else": {
    "properties": {
      "ok": {"type": "boolean"},
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"enum": ["node", "provider_key", "context_key", "ffmpeg", "ffprobe"]},
            "ok": {"type": "boolean"},
            "required": {"type": "boolean"},
            "detail": {"type": "string"}
          },
          "required": ["name", "ok", "required"]
        }
      },
      "commands": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "present": {"type": "boolean"},
                  "error": {"type": ["string", "null"]}
                },
                "required": ["name", "present", "error"]
              }
            },
            "name": {"type": "string"}
          },
          "required": ["name", "capabilities"]
        }
      },
      "leftovers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "examples": ["analyze", "transcribe", "calibration", "screenshots", "media-lock"]
            },
            "path": {"type": "string"},
            "sizeBytes": {"type": ["integer", "null"]},
            "ageMs": {"type": ["integer", "null"]},
            "state": {
              "type": "string",
              "examples": ["live", "abandoned", "unproven", "live or reused PID", "unknown owner"]
            },
            "removed": {"type": "boolean"},
            "reason": {"type": ["string", "null"]}
          },
          "required": ["kind", "path", "sizeBytes", "ageMs", "state", "removed", "reason"]
        }
      },
      "key": {"type": "object", "properties": {"present": {"type": "boolean"}}, "required": ["present"]},
      "artifactRoot": {"type": "string"},
      "toolVersion": {"type": "string"},
      "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
      "cliSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
      "roots": {
        "type": "object",
        "properties": {"mode": {"type": "string"}, "file": {"type": ["string", "null"]}},
        "required": ["mode", "file"]
      }
    },
    "required": [
      "ok",
      "checks",
      "commands",
      "leftovers",
      "key",
      "artifactRoot",
      "toolVersion",
      "commit",
      "cliSha256",
      "roots"
    ]
  }
}
