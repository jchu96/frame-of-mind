{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {"schemaVersion": {"const": 1}},
  "if": {"required": ["error"]},
  "then": {
    "properties": {
      "error": {
        "type": "object",
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}},
        "required": ["code", "message"]
      }
    }
  },
  "else": {
    "properties": {
      "outcome": {"enum": ["complete", "unchecked"]},
      "rechecks": {
        "type": "array", "items": {
          "type": "object",
          "properties": {
            "start": {"type": "number", "minimum": 0},
            "end": {"type": "number", "minimum": 0},
            "measuredSeconds": {"type": "number", "minimum": 0},
            "status": {"enum": ["linesAdded", "noNewLines", "failed", "skipped"]},
            "addedLines": {"type": "integer", "minimum": 0},
            "addedSpans": {"type": "array", "items": {
              "type": "object", "properties": {
                "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}
              }, "required": ["start", "end"]
            }}
          },
          "required": ["start", "end", "measuredSeconds", "status", "addedLines"]
        }
      },
      "belowCutoff": {
        "type": "object", "properties": {
          "stretches": {"type": "integer", "minimum": 0}, "seconds": {"type": "number", "minimum": 0}
        }, "required": ["stretches", "seconds"]
      },
      "quietLines": {"type": "integer", "minimum": 0},
      "retention": {"enum": ["provider", "run"]},
      "tokens": {
        "type": "object",
        "properties": {
          "promptTokens": {"type": "integer", "minimum": 0},
          "outputTokens": {"type": "integer", "minimum": 0},
          "totalTokens": {"type": "integer", "minimum": 1}
        },
        "required": ["promptTokens", "outputTokens", "totalTokens"]
      },
      "paths": {"type": "array", "items": {"type": "string"}},
      "model": {"type": "string"},
      "language": {"type": ["string", "null"]},
      "segmentCount": {"type": "integer"},
      "adjustedCues": {"type": "integer"},
      "blankCues": {"type": "integer"}
    },
    "required": ["paths", "model", "language", "segmentCount", "adjustedCues", "blankCues"]
  }
}
