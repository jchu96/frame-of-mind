{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "verify"},
    "actual": {"$ref": "#/definitions/measurement"},
    "expected": {"$ref": "#/definitions/measurement"},
    "mismatches": {"type": "array", "items": {"type": "string"}},
    "decodeStatus": {"const": "passed"}
  },
  "required": ["schemaVersion", "kind", "actual", "expected", "mismatches", "decodeStatus"],
  "definitions": {
    "measurement": {
      "type": "object",
      "properties": {
        "clock": {"const": "source"},
        "frames": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "rate": {
          "type": "object",
          "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}},
          "required": ["num", "den"]
        },
        "secondsDerived": {"const": true},
        "timecode": {"type": "string"},
        "dropFrame": {"type": "boolean"},
        "ticks": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "seconds": {"type": "string"},
        "ticksUnavailable": {"type": "string"},
        "secondsUnavailable": {"type": "string"}
      },
      "required": ["clock", "frames", "rate", "secondsDerived"]
    }
  }
}
