{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {"schemaVersion": {"const": 1}},
  "if": {"required": ["error"]},
  "then": {
    "properties": {
      "error": {
        "type": "object",
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object", "properties": {"frameTiming": {"$ref": "#/definitions/frameTiming"}}}},
        "required": ["code", "message"]
      }
    }
  },
  "else": {
    "properties": {
      "kind": {"type": "string", "examples": ["probe"]},
      "frameTiming": {"$ref": "#/definitions/frameTiming"},
      "duration": {"$ref": "#/definitions/measurement"},
      "width": {"type": "integer"},
      "height": {"type": "integer"},
      "codec": {"type": "string"},
      "hasAudio": {"type": "boolean"},
      "audio": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {"codec": {"type": "string"}, "channels": {"type": "integer"}},
          "required": ["codec", "channels"]
        }
      },
      "decodeStatus": {"type": "string", "examples": ["passed", "unchecked"]},
      "fileStartLabel": {
        "type": ["object", "null"],
        "properties": {
          "value": {
            "type": "object",
            "properties": {
              "clock": {"const": "source"},
              "frames": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "rate": {
                "type": "object",
                "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}},
                "required": ["num", "den"]
              }
            },
            "required": ["clock", "frames", "rate"]
          },
          "dropFrame": {"type": "boolean"}
        },
        "required": ["value", "dropFrame"]
      }
    },
    "required": [
      "kind",
      "duration",
      "width",
      "height",
      "codec",
      "hasAudio",
      "audio",
      "decodeStatus",
      "fileStartLabel"
    ]
  },
  "definitions": {
    "frameTiming": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["varying", "frames", "averageFramesPerSecond", "rates", "oddGaps", "oddShare"],
          "properties": {
            "varying": {"type": "boolean"}, "frames": {"type": "integer", "minimum": 3},
            "averageFramesPerSecond": {"type": "number", "minimum": 0},
            "rates": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["framesPerSecond", "gapMs", "share"],
              "properties": {"framesPerSecond": {"type": "number", "minimum": 0}, "gapMs": {"type": "number", "minimum": 0},
                "share": {"type": "number", "minimum": 0, "maximum": 1}}
            }},
            "oddGaps": {"type": "integer", "minimum": 0}, "oddShare": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["varying", "frames", "unread"],
          "properties": {
            "varying": {"type": "null"}, "frames": {"type": ["integer", "null"], "minimum": 0},
            "unread": {"enum": ["too few frames", "no picture", "frames with no time", "scan limit", "unavailable"]},
            "untimedFrames": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "properties": {
        "clock": {"const": "source"},
        "frames": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "rate": {
          "type": "object",
          "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}},
          "required": ["num", "den"]
        },
        "secondsDerived": {"const": true},
        "timecode": {"type": "string"},
        "dropFrame": {"type": "boolean"},
        "ticks": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "seconds": {"type": "string"},
        "ticksUnavailable": {"type": "string"},
        "secondsUnavailable": {"type": "string"}
      },
      "required": ["clock", "frames", "rate", "secondsDerived"]
    }
  }
}
