{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion"],
  "definitions": {
    "role": {
      "type":"object","required":["engine","model","source"],
      "properties":{"engine":{"type":"string"},"model":{"type":["string","null"]},"source":{"enum":["flag","recipe","default","file"]}}
    },
    "route": {"type":"object","required":["proposer","grader"],"properties":{"proposer":{"$ref":"#/definitions/role"},"grader":{"$ref":"#/definitions/role"}}},
    "nullableRoute": {"anyOf":[{"$ref":"#/definitions/route"},{"type":"null"}]},
    "enginePlan": {
      "type":"object","required":["planned","used","expected","reason","retention"],
      "properties":{
        "planned":{"$ref":"#/definitions/nullableRoute"},"used":{"$ref":"#/definitions/nullableRoute"},
        "expected":{"$ref":"#/definitions/nullableRoute"},"reason":{"type":"null"},
        "retention":{"type":"object","required":["gemini","twelvelabs"],"properties":{"gemini":{"enum":["provider","run",null]},"twelvelabs":{"type":"null"}}}
      }
    },
    "index": {"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "rate": {"type":"object","required":["num","den"],"properties":{"num":{"type":"integer","minimum":1},"den":{"type":"integer","minimum":1}}},
    "span": {"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/definitions/index"}},
    "coverage": {"type":"object","required":["full","covered"],"properties":{"full":{"type":"boolean"},"covered":{"type":"array","items":{"$ref":"#/definitions/span"}}}},
    "sourceRange": {"oneOf":[{"type":"object","required":["unit","fromFrame","toFrameExclusive","rate"],"properties":{"unit":{"const":"frames"},"fromFrame":{"$ref":"#/definitions/index"},"toFrameExclusive":{"$ref":"#/definitions/index"},"rate":{"$ref":"#/definitions/rate"}}},{"type":"object","required":["unit","fromSample","toSampleExclusive","rate"],"properties":{"unit":{"const":"samples"},"fromSample":{"$ref":"#/definitions/index"},"toSampleExclusive":{"$ref":"#/definitions/index"},"rate":{"$ref":"#/definitions/rate"}}},{"type":"object","required":["unit","fromTick","toTickExclusive","tick"],"properties":{"unit":{"const":"ticks"},"fromTick":{"$ref":"#/definitions/index"},"toTickExclusive":{"anyOf":[{"$ref":"#/definitions/index"},{"type":"null"}]},"tick":{"$ref":"#/definitions/rate"}}}]},
    "source": {"type":"object","properties":{"recordingSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"coverage":{"$ref":"#/definitions/coverage"},"sourceRange":{"$ref":"#/definitions/sourceRange"},"sourceLengthFrames":{"$ref":"#/definitions/index"},"sourceLengthSamples":{"$ref":"#/definitions/index"},"sourceLengthTicks":{"$ref":"#/definitions/index"},"sourceTiming":{"enum":["uneven","unproven"]},"maxRangeSeconds":{"type":"integer","minimum":1},"requestedRange":{"type":"object","required":["from","to"],"properties":{"from":{"type":["string","null"]},"to":{"type":["string","null"]}}},"edgeMoved":{"type":"object","required":["from","to"],"properties":{"from":{"type":"boolean"},"to":{"type":"boolean"}}}}}
  },
  "properties": {"schemaVersion": {"const": 1}},
  "if": {"required": ["error"]},
  "then": {
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "details": {"type":"object","allOf":[{"$ref":"#/definitions/source"}],"properties":{"phase":{"enum":["prepare","propose","grade","upload","index","cleanup"]},"sent":{"const":false},"reason":{"type":"string"},"runFolder": {"type": "string"}, "durationSeconds": {"type": "number"}, "limitSeconds": {"type": "number"}}}
        },
        "required": ["code", "message"]
      }
    }
  },
  "else": {
    "allOf": [{"$ref":"#/definitions/source"}],
    "properties": {
      "enginePlan":{"$ref":"#/definitions/enginePlan"},
      "retention": {"enum": ["provider", "run"]},
      "tokens": {
        "type": "object",
        "properties": {
          "promptTokens": {"type": "integer", "minimum": 0},
          "outputTokens": {"type": "integer", "minimum": 0},
          "totalTokens": {"type": "integer", "minimum": 1}
        },
        "required": ["promptTokens", "outputTokens", "totalTokens"]
      },
      "runFolder": {"type": "string", "description": "Directory containing manifest.json, whose optional thinkingLevel records the explicit --thinking-level input."},
      "runId": {"type": "string"},
      "outcome": {"type": "string"},
      "acceptedCount": {"type": "integer", "minimum": 0},
      "retainedUpload": {
        "type": ["object", "null"],
        "properties": {"name": {"type": "string"}, "expiresAt": {"type": ["string", "null"]}},
        "required": ["name", "expiresAt"]
      },
      "warnings": {"type": "array", "items": {"type": "string"}}
    },
    "if": {"required":["runFolder"]},
    "then":{"required":["runId","outcome","acceptedCount","retainedUpload"]},
    "else":{"required":["enginePlan"],"properties":{"enginePlan":{"type":"object","required":["planned","expected","used","reason","retention"],"properties":{"used":{"type":"null"}}}}}
  }
}
