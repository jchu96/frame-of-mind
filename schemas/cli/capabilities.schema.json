{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}},
        "required": ["name", "options"]
      }
    },
    "schemaVersions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
  },
  "required": ["schemaVersion", "commands", "schemaVersions"]
}
