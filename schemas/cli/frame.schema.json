{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {"schemaVersion": {"const": 1}},
  "if": {"required": ["error"]},
  "then": {
    "properties": {
      "error": {
        "type": "object",
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}},
        "required": ["code", "message"]
      }
    }
  },
  "else": {
    "properties": {
      "kind": {"type": "string", "examples": ["frame"]},
      "at": {"$ref": "#/definitions/measurement"},
      "width": {"type": "integer"},
      "height": {"type": "integer"},
      "decodeStatus": {"type": "string", "examples": ["passed"]},
      "output": {"type": "string"}
    },
    "required": ["kind", "at", "width", "height", "decodeStatus", "output"]
  },
  "definitions": {
    "measurement": {
      "type": "object",
      "properties": {
        "clock": {"const": "source"},
        "frames": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "rate": {
          "type": "object",
          "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}},
          "required": ["num", "den"]
        },
        "secondsDerived": {"const": true},
        "timecode": {"type": "string"},
        "dropFrame": {"type": "boolean"},
        "ticks": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "seconds": {"type": "string"},
        "ticksUnavailable": {"type": "string"},
        "secondsUnavailable": {"type": "string"}
      },
      "required": ["clock", "frames", "rate", "secondsDerived"]
    }
  }
}
