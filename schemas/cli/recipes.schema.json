{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"id": {"type": "string"}, "description": {"type": "string"}},
        "required": ["id", "description"]
      },
      "minItems": 1
    }
  },
  "required": ["schemaVersion", "recipes"]
}
