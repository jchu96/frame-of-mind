{
  "name": "@frame-of-mind/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "FRAME_OF_MIND_DB_DRIVER=sqlite NITRO_PRESET=node-server nuxi build",
    "build:cloudflare": "FRAME_OF_MIND_DB_DRIVER=d1 FRAME_OF_MIND_HOSTED_WORKFLOWS=1 NITRO_PRESET=cloudflare_module nuxi build && bun ../../scripts/build-hosted-entry.ts",
    "build:cloudflare:review": "FRAME_OF_MIND_DB_DRIVER=d1 NITRO_PRESET=cloudflare_module nuxi build",
    "cloudflare:types": "wrangler types --config wrangler.jsonc",
    "dev": "FRAME_OF_MIND_DB_DRIVER=sqlite nuxi dev --host 127.0.0.1",
    "import": "bun scripts/import-run.ts",
    "preview": "bun --preload ./.output/server/sentry.server.config.mjs ./.output/server/index.mjs",
    "typecheck": "nuxi typecheck && tsc -p tsconfig.server-local.json --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@nuxt/ui": "4.10.0",
    "@sentry/nuxt": "10.70.0",
    "better-auth": "1.7.1",
    "hash-wasm": "^4.12.0",
    "jose": "6.2.8",
    "nuxt": "4.5.2",
    "vue": "3.5.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@iconify-json/lucide": "1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@types/bun": "1.3.14",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9",
    "wrangler": "4.123.0"
  }
}
