{
  "name": "@frame-of-mind/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "FRAME_OF_MIND_DB_DRIVER=sqlite NITRO_PRESET=node-server nuxi build",
    "build:cloudflare": "FRAME_OF_MIND_DB_DRIVER=d1 NITRO_PRESET=cloudflare-worker nuxi build",
    "cloudflare:types": "wrangler types --config wrangler.jsonc",
    "dev": "FRAME_OF_MIND_DB_DRIVER=sqlite nuxi dev --host 127.0.0.1",
    "import": "bun scripts/import-run.ts",
    "preview": "bun .output/server/index.mjs",
    "typecheck": "nuxi typecheck && tsc -p tsconfig.server-local.json --noEmit"
  },
  "dependencies": {
    "@nuxt/ui": "4.10.0",
    "jose": "6.2.5",
    "nuxt": "4.5.0",
    "vue": "3.5.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@iconify-json/lucide": "1.2.120",
    "@types/bun": "1.3.14",
    "miniflare": "4.20260722.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.8",
    "wrangler": "4.114.0"
  }
}
