{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frame-of-mind",
  "main": ".output/server/hosted-entry.mjs",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "frame-of-mind.example.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frame-of-mind",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "db/migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "services": [
    {
      "binding": "HOSTED_WORKFLOWS",
      "service": "REPLACE_WITH_INTERNAL_WORKFLOWS_WORKER"
    }
  ],
  "vars": {
    "NUXT_AUTH_MODE": "cloudflare-access",
    "NUXT_CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "NUXT_CLOUDFLARE_ACCESS_AUD": "REPLACE_WITH_APPLICATION_AUD",
    "NUXT_BETTER_AUTH_MAILER_FROM": "sign-in@REPLACE_WITH_DOMAIN",
    "NUXT_ACCESS_REQUEST_NOTIFY": "maintainer@REPLACE_WITH_DOMAIN",
    "NUXT_ACCESS_REQUEST_PENDING_CAP": "200",
    "NUXT_HOSTED_WORKFLOWS_ENABLED": "false",
    "NUXT_HOSTED_MEDIA_OPEN_SESSION_CAP": "2",
    "NUXT_HOSTED_MEDIA_MAX_BYTES": "2147483648",
    "NUXT_HOSTED_MEDIA_SESSION_TTL_SECONDS": "3600"
  },
  "observability": {
    "enabled": true
  }
}
